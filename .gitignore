# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are unanchored (no leading slash) since node_modules/.next/etc.
# now live in each workspace (backend/, admin/, mobile/), not just the root.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# expo / react native (mobile/)
.expo/
expo-env.d.ts
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# IDE
.vscode/
.idea/

# OS
Thumbs.db

# logs
*.log

# local Claude Code runtime state (not shared config)
.claude/scheduled_tasks.lock
